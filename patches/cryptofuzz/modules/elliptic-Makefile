all: module.a

CXXFLAGS += -Wall -Wextra -Werror -std=c++17 -I ../../include -I ../../fuzzing-headers/include -DFUZZING_HEADERS_NO_IMPL

module.a: module.o
	ar rcs module.a module.o
	ranlib module.a
generate_ids : generate_ids.cpp
	$(CXX) -Wall -Wextra -Werror -std=c++17 -I ../../include -I ../../fuzzing-headers/include -DFUZZING_HEADERS_NO_IMPL generate_ids.cpp -o generate_ids
ids.js : generate_ids
	./generate_ids >ids.js
elliptic.bytecode : header.js harness.js ids.js
	rm -rf elliptic.bytecode elliptic.js
	cat header.js $(ELLIPTIC_PATH) ids.js crypto-js/core.js crypto-js/x64-core.js crypto-js/sha256.js harness.js >combined.js
	npm run build
	$(LIBFUZZER_JS_PATH)/to_bytecode elliptic.js elliptic.bytecode
elliptic.bytecode.h : elliptic.bytecode
	xxd -i elliptic.bytecode >elliptic.bytecode.h
module.o: module.cpp module.h elliptic.bytecode.h
	test $(LIBFUZZER_JS_PATH)
	$(CXX) $(CXXFLAGS) -I $(LIBFUZZER_JS_PATH) -fPIC -c module.cpp -o module.o
clean:
	rm -rf *.o module.a combined.js elliptic.js ids.js generate_ids elliptic.bytecode elliptic.bytecode.h